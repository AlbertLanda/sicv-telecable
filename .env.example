# Plantilla de configuracion del SICV.
# Copiar como .env y completar con valores locales.
# NUNCA colocar secretos reales en este archivo (esta versionado).

# Clave de firma de Django. Cada entorno usa una clave distinta.
# Generar una local con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-local-env

# True solo en desarrollo local.
DJANGO_DEBUG=True

# Lista separada por comas. En produccion usar el dominio real, nunca *.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: en desarrollo y CI se usa SQLite (no requiere configuracion).
# Las variables de PostgreSQL se documentaran/activaran en una actividad posterior.
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=5432

# Consulta automatica de DNI/RUC (boton "Obtener datos" en Registrar Cliente).
# Proveedor: Peru API (https://peruapi.com). Registrarse gratis en
# https://peruapi.com/registro y copiar el token desde el panel.
# Plan Free: 50 consultas/dia y 1000/mes (compartido entre DNI y RUC).
# Si se deja vacio, el boton mostrara un aviso y el registro manual sigue
# funcionando con normalidad.
# Ver docs/consulta_documento_externa.md para mas detalle.
SUNAT_API_TOKEN=71368bd6866a8cfa193815b7e7da58a1
SUNAT_API_BASE_URL=https://peruapi.com/api
SUNAT_API_TIMEOUT=8
