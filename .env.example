# Plantilla de configuracion del SICV.
# Copiar como .env y completar con valores locales.
# NUNCA colocar secretos reales en este archivo (esta versionado).

# Clave de firma de Django. Cada entorno usa una clave distinta.
# Generar una local con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-local-env

# Desarrollo local.
DJANGO_DEBUG=True
DJANGO_PRODUCTION=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# En Azure App Service:
# DJANGO_DEBUG=False
# DJANGO_PRODUCTION=True
# DJANGO_ALLOWED_HOSTS=miapp.azurewebsites.net,sicv.telecable.pe
# DJANGO_CSRF_TRUSTED_ORIGINS=https://miapp.azurewebsites.net,https://sicv.telecable.pe

# PostgreSQL. Local/CI pueden dejar DJANGO_DB_ENGINE=sqlite.
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_NAME=sicv
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=5432
# DJANGO_DB_SSLMODE=require
# DJANGO_DB_CONN_MAX_AGE=60

# Hardening HTTPS. DJANGO_PRODUCTION=True ya activa redirect y cookies seguras.
# Durante el piloto HSTS inicia en una hora para poder corregir dominio/TLS sin
# quedar atrapados por una politica larga en el navegador.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False

# Static de Django. En Azure se ejecuta collectstatic y WhiteNoise los sirve.
# DJANGO_STATIC_URL=/static/
# DJANGO_STATIC_ROOT=/home/site/wwwroot/staticfiles

# Consulta automatica de DNI/RUC.
JSONPE_API_TOKEN=
JSONPE_API_BASE_URL=https://api.json.pe/api
JSONPE_API_TIMEOUT=8

# Integracion anterior con Peru API.
SUNAT_API_TOKEN=
SUNAT_API_BASE_URL=https://peruapi.com/api
SUNAT_API_TIMEOUT=8

# Azure Blob Storage se configurara en la siguiente etapa.
# Hasta entonces MEDIA_ROOT sigue siendo local y NO debe usarse el piloto con
# firmas/evidencias reales.
