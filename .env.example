# Plantilla de configuracion del SICV.
# Copiar como .env y completar con valores locales.
# NUNCA colocar secretos reales en este archivo (esta versionado).

# Clave de firma de Django. Cada entorno usa una clave distinta.
# Generar una local con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-local-env

# True solo en desarrollo local.
DJANGO_DEBUG=True

# Lista separada por comas. En produccion usar el dominio real, nunca *.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: en desarrollo y CI se usa SQLite (no requiere configuracion).
# Las variables de PostgreSQL se documentaran/activaran en una actividad posterior.
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=5432

# Consulta automatica de DNI/RUC.
# Proveedor activo: JSON.pe.
# El token real debe configurarse solo en .env y nunca versionarse.
JSONPE_API_TOKEN=
JSONPE_API_BASE_URL=https://api.json.pe/api
JSONPE_API_TIMEOUT=8

# Integracion anterior con Peru API.
# Se conserva temporalmente por compatibilidad mientras se completa
# la limpieza del proveedor legado.
SUNAT_API_TOKEN=
SUNAT_API_BASE_URL=https://peruapi.com/api
SUNAT_API_TIMEOUT=8