      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal Bootstrap: consultar o actualizar.",
      "html": "<button class=\"ds-primary\" type=\"button\">Buscar</button>",
      "css": ".ds-primary{font-family:var(--tc-font,Inter,system-ui,-apple-system,'Segoe UI',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:40px;padding:.375rem .75rem;font-size:.875rem;font-weight:600;line-height:1.5;border:1px solid var(--sicv-primary,#0755a6);border-radius:4px;background:var(--sicv-primary,#0755a6);color:#fff;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out}.ds-primary:hover,.ds-primary:focus{background:var(--sicv-primary-dark,#053c78);border-color:var(--sicv-primary-dark,#053c78)}.ds-primary:focus-visible{outline:2px solid var(--sicv-primary,#0755a6);outline-offset:3px;box-shadow:0 0 0 .25rem rgba(49,132,253,.5)}.ds-primary:active{background:#0a58ca;border-color:#0a53be}@media(max-width:575.98px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:0s}}"
    },
