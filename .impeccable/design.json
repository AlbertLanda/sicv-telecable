      "css": ".ds-secondary{font-family:var(--tc-font,Inter,system-ui,-apple-system,'Segoe UI',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 14px;font-size:.875rem;font-weight:500;line-height:1.5;border:1px solid #aebbc7;border-radius:4px;background:#fff;color:var(--sicv-primary,#0755a6);cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease,box-shadow .15s ease}.ds-secondary:hover{background:var(--sicv-soft,#edf3fa);border-color:#aebbc7;color:var(--sicv-primary,#0755a6);box-shadow:none}.ds-secondary:focus-visible{outline:2px solid var(--sicv-primary,#0755a6);outline-offset:3px;}.ds-secondary:active{box-shadow:inset 0 1px 3px rgba(10,59,102,.25)}@media(max-width:575.98px){.ds-secondary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition-duration:0s}}"
